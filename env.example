POSTGRES_PASSWORD=password

# Optional build proxies. Leave empty for direct access. Do not commit credentials.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,api,db,admin,theme
# Optional PEM CA bundle path; use compose.build-ca.yaml when set.
# With Docker via WSL, use the WSL-visible path, not a Windows path.
RUSTPRESS_BUILD_CA=